generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}



model User {
  id            String       @id @default(cuid())
  email         String       @unique
  password      String
  role          String         @default("STUDENT")
  profile       Profile?
  studyPlans    StudyPlan[]
  quizResults   QuizResult[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([email])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  school      String?
  avatarUrl   String?
  bio         String?
  updatedAt   DateTime @updatedAt
}

model Course {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String?
  modules     Module[]
  studyPlans  StudyPlan[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([code])
}

model Module {
  id          String      @id @default(cuid())
  courseId    String
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  content     String
  type        String      // e.g., "flashcard", "quiz", "study_guide"
  order       Int
  studyPlans  StudyPlan[] @relation("StudyPlanModules")
  quizResults QuizResult[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([courseId])
}

model StudyPlan {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id])
  title       String
  startDate   DateTime
  endDate     DateTime
  status      String    @default("active") // active, completed, archived
  modules     Module[]  @relation("StudyPlanModules")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([courseId])
}

model QuizResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  score     Float
  total     Int
  answers   String // JSON string of answers
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([moduleId])
}

model Order {
  id           String    @id @default(cuid())
  orderNumber  String    @unique @default(cuid())
  studentName  String
  studentEmail String
  school       String
  courseCode   String
  courseName   String
  examType     String
  examDate     DateTime
  duration     Int
  commitment   String
  topics       String
  notes        String?
  files        String    @default("[]")
  status       String    @default("pending")
  quoteAmount  Float?
  quoteModules String?
  quoteNote    String?
  quoteSentAt  DateTime?
  paymentLink  String?
  paidAt       DateTime?
  activatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
