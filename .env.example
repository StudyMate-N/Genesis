# ═══════════════════════════════════════════════
# CERTIPREP ACADEMIC — Production Environment Template
# Copy to .env.local and fill in real values
# ═══════════════════════════════════════════════

# Database (Supabase)
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# Admin
ADMIN_PASSWORD=your-strong-password
JWT_SECRET=generate-with-node-crypto-randomBytes-32-toString-hex

# Email (Resend — real key starts with re_)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=CertiPrep Academic <prep@yourdomain.com>

# Notifications (optional Slack/Discord webhook)
NOTIFICATION_WEBHOOK_URL=

# Site URL (your domain)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
